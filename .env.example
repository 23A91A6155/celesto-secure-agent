# Celesto Secure Agent Configuration Example
# Copy this file to .env for local runtime configuration.
# Never commit real credentials or production keys.

# Celesto MicroVM Provider Configuration
# Allowed values: local (Firecracker/QEMU microVMs), cloud (Celesto Cloud API)
CELESTO_PROVIDER=local
CELESTO_API_KEY=replace_with_your_celesto_api_key

# Language Model Configuration
LLM_API_KEY=replace_with_your_llm_api_key
LLM_MODEL=replace_with_supported_model

# PostgreSQL Run Ledger Database Connection
DATABASE_URL=postgresql://app:app_password@ledger:5432/celesto_ledger

# API Control Plane Server Port
API_PORT=8080

# Environment Mode: development, staging, production
ENVIRONMENT=development

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Command Gateway Security Bounding
COMMAND_TIMEOUT_SECONDS=30
MAX_STEP_COUNT=10
MAX_OUTPUT_BYTES=65536
MAX_COMMAND_LENGTH=1024
